;; Game: a frame of Phaser 1.1.3 (Game.update), over the events of
;; env/raylib.atm, so that a port does in each frame what its original did,
;; in the same order:
;;
;;      (tweens_pass)   tweens.update: the tweens of Motion move
;;      :pre            world.update: each sprite updates its animation and
;;                      tests if it left the world; then the bodies move
;;                      (physics_pre)
;;      :particles      particles.update: the emitters emit
;;      :update         state.update: the game
;;      :overlap        the end of state.update, where the games call
;;                      physics.overlap and physics.collide
;;      (physics_post)  world.postUpdate: the sprites follow their bodies
;;      :rl.draw        render
;;
;; The game awaits :pre and :update, not :rl.frame. `await Wait(ms)` is a
;; comparison with the clock of Phaser, in :update, as
;; `if (game.time.now > this.time)` was in an update.

include "engine.atm"
include "motion.atm"
include "sprite.atm"
include "physics.atm"
include "particles.atm"

;; Phaser 1.1.3, when it boots, seeds game.rnd with one draw of Math.random:
;; new Phaser.RandomDataGenerator([(Date.now() * Math.random()).toString()]),
;; with the clock of the harness at 1000
eng.rnd_sow(eng.tostring(1000 * eng.random()))

;; Keys: the frame of the last press of each key (an :rl.key.dn before
;; frame f is a keydown before the update of frame f)
val Keys = [ frame = 0, pressed = [] ]

;; Cursor(): the keys of a state, as game.input.keyboard.createCursorKeys():
;; new keys, which are up until pressed after they were created. A key held
;; from the previous state is not down in the next one until pressed again.
;;
;;      val keys = Cursor()
;;      if cursor_down(keys, 'UP') { ... }
func Cursor () {
    :Cursor [ born = Keys.frame ]
}

func cursor_down (c, k) {
    rl.key_down(k) && ((Keys.pressed@(k) || -1) > c.born)
}

task Wait (ms) {
    val t = eng.now() + ms
    await :update until eng.now() > t
}

task Game (w, h) {
    set Physics.w = w
    set Physics.h = h
    spawn {
        loop e on :rl.key.dn {
            if e.name {
                set Keys.pressed@(e.name) = Keys.frame + 1
            }
        }
    }
    var prev = eng.now()
    loop on :rl.frame {
        set Keys.frame += 1
        eng.tick()
        val now = eng.now()
        set Physics.elapsed = now - prev
        set Physics.dt = Physics.elapsed / 1000
        set prev = now
        tweens_pass()
        emit @:global :pre
        physics_pre()
        emit @:global :particles
        emit @:global :update
        emit @:global :overlap
        physics_post()
        physics_draw()
    }
}
