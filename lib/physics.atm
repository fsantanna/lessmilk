;; Physics: what the games use of the arcade physics of Phaser 1.1.3, read
;; from its source (ext/phaser/1.1.3/src/physics/arcade/).
;;
;; A body belongs to a sprite. It has a box of the size of a frame, placed by
;; the anchor of the sprite, and the fields of Phaser.Physics.Arcade.Body:
;;
;;      val b = Body(spr, :enemy)           ;; registers it in Physics.bodies
;;      set b.vx = -300                     ;; px/s, as body.velocity.x
;;      set b.gy = 12                       ;; body.gravity.y
;;      set b.world = true                  ;; collideWorldBounds
;;      set b.immovable = true
;;      collide(a, b)                       ;; physics.collide of two sprites
;;      b.touching.down                     ;; after a collide, in a frame
;;
;; Each frame of Phaser runs, in this order (lib/game.atm drives it):
;;
;;      physics_pre()   preUpdate: each body takes the position of its sprite
;;                      as drawn in the last frame (a 32-bit float, as in the
;;                      transform of Pixi), and its size from the scale of
;;                      that transform; then it moves (updateMotion), and
;;                      stays in the world
;;      ...             the update of the game, which may collide and overlap
;;      physics_post()  postUpdate: each sprite moves by what its body moved,
;;                      and turns by what it turned
;;      physics_draw()  the transform drawn, for the next preUpdate
;;
;; Out of bounds: `in_world(spr)` tests the bounds of the sprite as drawn in
;; the last frame, rotated, against the world, as Sprite.updateBounds does.

```:prelude
// The scale of a sprite, as Sprite.updateCache computes it from the world
// transform of Pixi (32-bit floats): not exactly the scale when rotated.
// Body.updateBounds takes it as the scale of the body.
static void phs_scale (double rot, double sx, double sy, double* out) {
    double sr = sin(rot), cr = cos(rot);
    float a00 = (float)(cr * sx), a01 = (float)(-sr * sy);
    float a10 = (float)(sr * sx), a11 = (float)(cr * sy);
    double d00 = a00, d01 = a01, d10 = a10, d11 = a11;
    out[0] = sqrt(d00*d00 + d01*d01);
    out[1] = sqrt(d10*d10 + d11*d11);
}

// The four corners of a sprite (topLeft, topRight, bottomLeft, bottomRight,
// as x y), as Sprite.updateBounds computes them with getLocalPosition.
static void phs_corners (double x, double y, double rot, double sx, double sy,
                         double fw, double fh, double ax, double ay, double* out) {
    double sr = sin(rot), cr = cos(rot);
    float l0 = (float)(cr * sx), l1 = (float)(-sr * sy);
    float l3 = (float)(sr * sx), l4 = (float)(cr * sy);
    double a00 = l0, a01 = l1, a10 = l3, a11 = l4;
    double a02 = (float)x, a12 = (float)y;
    a01 *= -1;
    a10 *= -1;
    double id = 1 / (a00 * a11 + a01 * -a10);
    double width  = sx * fw;
    double height = sy * fh;
    double ox = a02 - (ax * width);
    double oy = a12 - (ay * height);
    double cx[4] = { ox, ox + width, ox, ox + width };
    double cy[4] = { oy, oy, oy + height, oy + height };
    for (int i=0; i<4; i++) {
        double X = cx[i], Y = cy[i];
        out[2*i]   = ((a11 * id * X + -a01 * id * Y + (a12 * a01 - a02 * a11) * id) * sx) + a02;
        out[2*i+1] = ((a00 * id * Y + -a10 * id * X + (-a12 * a00 + a02 * a10) * id) * sy) + a12;
    }
}

// Sprite.getLocalUnmodifiedPosition: the point (px,py) of the screen in
// the frame of the sprite, unscaled, as InputHandler.checkPointerOver uses
// it, from the transform drawn (32-bit floats). Out: x y.
static void phs_local (double x, double y, double rot, double sx, double sy,
                       double fw, double fh, double ax, double ay,
                       double px, double py, double* out) {
    double sr = sin(rot), cr = cos(rot);
    float l0 = (float)(cr * sx), l1 = (float)(-sr * sy);
    float l3 = (float)(sr * sx), l4 = (float)(cr * sy);
    double a00 = l0, a11 = l4, i01 = l1, i10 = l3;
    double a02 = (float)x, a12 = (float)y;
    double idi = 1 / (a00 * a11 + i01 * -i10);
    out[0] = a11*idi*px + -i01*idi*py + (a12*i01 - a02*a11)*idi + ax*fw;
    out[1] = a00*idi*py + -i10*idi*px + (-a12*a00 + a02*i10)*idi + ay*fh;
}

// The bounds of a sprite, as Phaser 1.1.3 computes them in
// Sprite.updateCache and Sprite.updateBounds, from the world transform of
// Pixi, which is a Float32Array: x y of the last frame drawn, its angle in
// degrees, its scale, the size of its frame, and its anchor.
// Out: left top right bottom.
static void phs_bounds (double x, double y, double rot, double sx, double sy,
                        double fw, double fh, double ax, double ay, double* out) {
    double sr = sin(rot), cr = cos(rot);
    float l0 = (float)(cr * sx), l1 = (float)(-sr * sy);
    float l3 = (float)(sr * sx), l4 = (float)(cr * sy);
    float w0 = (float)(1.0*l0 + 0.0*l3), w1 = (float)(1.0*l1 + 0.0*l4);
    float w3 = (float)(0.0*l0 + 1.0*l3), w4 = (float)(0.0*l1 + 1.0*l4);
    float w2 = (float)x, w5 = (float)y;
    double a00 = w0, a01 = w1, a10 = w3, a11 = w4;
    double a02 = w2, a12 = w5;
    a01 *= -1;
    a10 *= -1;
    double id = 1 / (a00 * a11 + a01 * -a10);
    double width  = sx * fw;
    double height = sy * fh;
    double ox = a02 - (ax * width);
    double oy = a12 - (ay * height);
    double px[4], py[4];
    double cx[4] = { ox, ox + width, ox, ox + width };
    double cy[4] = { oy, oy, oy + height, oy + height };
    for (int i=0; i<4; i++) {
        double X = cx[i], Y = cy[i];
        px[i] = ((a11 * id * X + -a01 * id * Y + (a12 * a01 - a02 * a11) * id) * sx) + a02;
        py[i] = ((a00 * id * Y + -a10 * id * X + (-a12 * a00 + a02 * a10) * id) * sy) + a12;
    }
    double l = px[0], r = px[0], t = py[0], b = py[0];
    for (int i=1; i<4; i++) {
        if (px[i] < l) l = px[i];
        if (px[i] > r) r = px[i];
        if (py[i] < t) t = py[i];
        if (py[i] > b) b = py[i];
    }
    out[0] = l; out[1] = t; out[2] = r; out[3] = b;
}
```

val Physics = [
    x = 0, y = 0,           ;; the world: (x, y, w, h) (world.setBounds)
    w = 0, h = 0,
    elapsed = 0,            ;; game.time.elapsed, in ms
    dt = 0,                 ;; game.time.physicsElapsed, in seconds
    gx = 0, gy = 0,         ;; game.physics.gravity
    bodies = [],            ;; the bodies, in the order they were created
    qt = nil,               ;; the quadtree of the frame
]

;; camera.x and camera.y set (Camera in lib/sprite.atm): kept in the bounds of
;; the world (Camera.checkBounds, with view.floor()), as the setter does
func camera_set (k, v) {
    set Camera@(k) = v
    if Camera.x < Physics.x {
        set Camera.x = Physics.x
    }
    if Camera.x > ((Physics.x + Physics.w) - Camera.w) {
        set Camera.x = ((Physics.x + Physics.w) - Camera.w) + 1
    }
    if Camera.y < Physics.y {
        set Camera.y = Physics.y
    }
    if Camera.y > ((Physics.y + Physics.h) - Camera.h) {
        set Camera.y = ((Physics.y + Physics.h) - Camera.h) + 1
    }
    set Camera.x = math.floor(Camera.x)
    set Camera.y = math.floor(Camera.y)
}

;; a 32-bit float, as the transforms of Pixi keep positions
func f32 (x) {
    `:number.float (double)(float)a_dbl($x)`
}

;; the scale of the transform drawn of a sprite (see phs_scale)
func drawn_scale (s) {
    val r, sx, sy = (s.drot, s.dsx, s.dsy)
    val a = `:number.float ({ double o[2]; phs_scale(a_dbl($r), a_dbl($sx), a_dbl($sy), o); o[0]; })`
    val b = `:number.float ({ double o[2]; phs_scale(a_dbl($r), a_dbl($sx), a_dbl($sy), o); o[1]; })`
    (a, b)
}

;; Sprite.updateCache and the render: the transform drawn, read by the next
;; preUpdate: the position on the screen, x - camera.x, as a 32-bit float
;; (worldTransform[2] of Pixi); the rotation; the scale. The position in the
;; world is camera.x + dx, with the camera of the time it is read.
func sprite_drawn (s) {
    set s.dx  = f32(s.x - Camera.x)
    set s.dy  = f32(s.y - Camera.y)
    set s.drot = s.rot
    set s.dsx = s.sx
    set s.dsy = s.sy
}

;; A body for the sprite, with the size of its frame, in a group (a tag, to
;; test overlaps against). It starts where the sprite is, and is in the
;; world only after its first preUpdate.
func Body (spr, group) {
    val b = :Body [
        spr = spr,
        group = group,
        w = spr.img.fw * spr.sx, h = spr.img.fh * spr.sy,
        sw = spr.img.fw, sh = spr.img.fh,   ;; sourceWidth, sourceHeight
        ox = 0, oy = 0,                     ;; offset
        x = spr.x, y = spr.y, px = spr.x, py = spr.y,
        rot = 0, prot = 0,              ;; degrees, as body.rotation
        vx = 0, vy = 0,                 ;; velocity
        accx = 0, accy = 0,             ;; acceleration
        dragx = 0, dragy = 0,           ;; drag
        gx = 0, gy = 0,                 ;; gravity of the body
        bx = 0, by = 0,                 ;; bounce
        maxx = 10000, maxy = 10000,     ;; maxVelocity
        av = 0, aacc = 0, adrag = 0, amax = 1000,  ;; angular
        mass = 1,
        immovable = false,
        moves = true,
        allow_rotation = true,
        allow_gravity = true,
        none = false,                   ;; allowCollision.none
        world = false,                  ;; collideWorldBounds
        touching = [ up=false, down=false, left=false, right=false ],
        live = false,                   ;; in the quadtree of this frame
    ]
    sprite_drawn(spr)
    set Physics.bodies@+ = b
    b
}

func body_remove (b) {
    loop i, v in Physics.bodies {
        if v == b {
            vector.remove(Physics.bodies, i)
            break
        }
    }
}

;; body.setSize(w, h, ox, oy)
func body_set_size (b, w, h, ox, oy) {
    set b.sw, b.sh = (w, h)
    set b.ox, b.oy = (ox || b.ox, oy || b.oy)
}

;; Sprite.reset(x, y): the sprite moves; the body takes the position drawn
func body_reset (b, x, y) {
    set b.spr.x = x
    set b.spr.y = y
    set b.vx, b.vy = (0, 0)
    set b.accx, b.accy = (0, 0)
    set b.av, b.aacc = (0, 0)
    set b.px = ((Camera.x + b.spr.dx) - (b.spr.ax * b.w)) + b.ox
    set b.py = ((Camera.y + b.spr.dy) - (b.spr.ay * b.h)) + b.oy
    set b.x = b.px
    set b.y = b.py
    set b.rot = angle_get(b.spr)
    set b.prot = b.rot
}

;; ArcadePhysics.computeVelocity
func compute_velocity (axis, b, v, acc, drag, max) {
    var vel = v
    val m = max || 10000
    if (axis == 1) && b.allow_gravity {
        set vel += Physics.gx + b.gx
    } else {
        if (axis == 2) && b.allow_gravity {
            set vel += Physics.gy + b.gy
        }
    }
    ifs {
        acc != 0 => set vel += acc * Physics.dt
        drag != 0 => {
            val d = drag * Physics.dt
            ifs {
                (vel - d) > 0 => set vel -= d
                (vel + d) < 0 => set vel += d
                else => set vel = 0
            }
        }
    }
    ifs {
        vel > m => m
        vel < -m => -m
        else => vel
    }
}

;; ArcadePhysics.updateMotion: half of the change of velocity before the
;; move, half after. As in phaser113.min.js, which the games run: the
;; minifier wrote `(cv - v) * dt * 0.5 * 60` of the source as
;; `60 * .5 * (cv - v) * dt`, which rounds differently: (30 * (cv - v)) * dt.
func update_motion (b) {
    val dt = Physics.dt
    var d = (30 * (compute_velocity(0, b, b.av, b.aacc, b.adrag, b.amax) - b.av)) * dt
    set b.av += d
    set b.rot += b.av * dt
    set b.av += d
    set d = (30 * (compute_velocity(1, b, b.vx, b.accx, b.dragx, b.maxx) - b.vx)) * dt
    set b.vx += d
    set b.x += b.vx * dt
    set b.vx += d
    set d = (30 * (compute_velocity(2, b, b.vy, b.accy, b.dragy, b.maxy) - b.vy)) * dt
    set b.vy += d
    set b.y += b.vy * dt
    set b.vy += d
}

;; Sprite.preUpdate and Body.preUpdate, for all bodies, in order; then the
;; quadtree of the frame, with the bodies that may collide
func physics_pre () {
    qt_clear()
    var order = 0
    loop _, b in Physics.bodies {
        val s = b.spr
        ;; renderOrderID: the order of the sprites updated in this frame
        ifs {
            s.exists == false => set s.render_order = -1
            s.visible != false => {
                set s.render_order = order
                set order += 1
            }
        }
        if (s.exists != false) && s.oob_kill {
            ;; Sprite.updateBounds: outOfBoundsKill, from the bounds drawn,
            ;; when the sprite was in the world and is not anymore
            val now_in = in_world(s)
            val was_in = s.in_world != false
            set s.in_world = now_in
            if was_in && !now_in {
                sprite_kill(s)
            }
        }
        if (s.exists != false) && s.oob_signal {
            ;; events.onOutOfBounds, with no kill
            val now_in = in_world(s)
            val was_in = s.in_world != false
            set s.in_world = now_in
            if was_in && !now_in {
                set s.left_world = true
            }
        }
        if s.exists != false {
            ;; Body.updateBounds: the size of the body, from the scale drawn
            val scx, scy = drawn_scale(s)
            set b.w = b.sw * scx
            set b.h = b.sh * scy
            set b.touching.up, b.touching.down = (false, false)
            set b.touching.left, b.touching.right = (false, false)
            set b.px = ((Camera.x + s.dx) - (s.ax * b.w)) + b.ox
            set b.py = ((Camera.y + s.dy) - (s.ay * b.h)) + b.oy
            set b.x = b.px
            set b.y = b.py
            set b.prot = angle_get(s)
            set b.rot = b.prot
            if b.moves {
                update_motion(b)
                if b.world {
                    val rx, by_ = (Physics.x + Physics.w, Physics.y + Physics.h)
                    ifs {
                        b.x < Physics.x => { set b.x = Physics.x ; set b.vx *= -b.bx }
                        (b.x + b.w) > rx => { set b.x = rx - b.w ; set b.vx *= -b.bx }
                    }
                    ifs {
                        b.y < Physics.y => { set b.y = Physics.y ; set b.vy *= -b.by }
                        (b.y + b.h) > by_ => { set b.y = by_ - b.h ; set b.vy *= -b.by }
                    }
                }
            }
            set b.live = !b.none && (s.visible != false) && (s.alive != false)
            if b.live {
                qt_insert(Physics.qt, b)
            }
        } else {
            set b.live = false
        }
    }
}

;; Body.postUpdate, for all bodies of sprites that exist
func physics_post () {
    loop _, b in Physics.bodies {
        if b.spr.exists != false {
            val dx = b.x - b.px
            val dy = b.y - b.py
            if (dx != 0) || (dy != 0) {
                set b.spr.x += dx
                set b.spr.y += dy
            }
            if b.allow_rotation {
                angle_set(b.spr, angle_get(b.spr) + (b.rot - b.prot))
            }
        }
    }
}

;; The render: the transforms drawn, which the next preUpdate reads; Pixi
;; does not update the transform of what is not visible
func physics_draw () {
    loop _, b in Physics.bodies {
        if b.spr.visible != false {
            sprite_drawn(b.spr)
        }
    }
}

;; Sprite.reset(x, y) of a sprite with a body: it lives again
func sprite_reset (s, b, x, y) {
    set s.alive, s.exists, s.visible = (true, true, true)
    body_reset(b, x, y)
}

;; Sprite.kill
func sprite_kill (s) {
    set s.alive, s.exists, s.visible = (false, false, false)
}

;; Phaser.QuadTree of 1.1.3 (math/QuadTree.js): the world, 10 objects per
;; node, 4 levels; its order is the order in which overlaps are found
func qt_node (x, y, w, h, level) {
    val rx, ry = (math.floor(x + 0.5), math.floor(y + 0.5))
    :QuadTree [
        x = rx, y = ry, w = w, h = h,
        right = rx + math.floor(w / 2),
        bottom = ry + math.floor(h / 2),
        sw = math.floor(w / 2), sh = math.floor(h / 2),
        level = level || 0,
        objects = [],
        nodes = nil,
    ]
}

func qt_clear () {
    set Physics.qt = qt_node(Physics.x, Physics.y, Physics.w, Physics.h, 0)
}

func qt_index (q, r) {
    val rr, rb = (r.x + r.w, r.y + r.h)
    ifs {
        (r.x < q.right) && (rr < q.right) => ifs {
            (r.y < q.bottom) && (rb < q.bottom) => 1
            r.y > q.bottom => 2
            else => -1
        }
        r.x > q.right => ifs {
            (r.y < q.bottom) && (rb < q.bottom) => 0
            r.y > q.bottom => 3
            else => -1
        }
        else => -1
    }
}

;; split: the level of the node goes up first, as in 1.1.3
func qt_split (q) {
    set q.level += 1
    set q.nodes = [
        qt_node(q.right, q.y, q.sw, q.sh, q.level),
        qt_node(q.x, q.y, q.sw, q.sh, q.level),
        qt_node(q.x, q.bottom, q.sw, q.sh, q.level),
        qt_node(q.right, q.bottom, q.sw, q.sh, q.level),
    ]
}

func qt_insert (q, b) {
    if q.nodes {
        val i = qt_index(q, b)
        if i != -1 {
            qt_insert(q.nodes@(i), b)
            return nil
        }
    }
    set q.objects@+ = b
    if (#q.objects > 10) && (q.level < 4) {
        if !q.nodes {
            qt_split(q)
        }
        var i = 0
        loop {
            while i < #q.objects
            val j = qt_index(q, q.objects@(i))
            if j != -1 {
                qt_insert(q.nodes@(j), vector.remove(q.objects, i))
            } else {
                set i += 1
            }
        }
    }
    nil
}

func qt_retrieve (q, b, out) {
    loop _, o in q.objects {
        set out@+ = o
    }
    if q.nodes {
        val i = qt_index(q, b)
        if i != -1 {
            qt_retrieve(q.nodes@(i), b, out)
        } else {
            loop k in 4 {
                qt_retrieve(q.nodes@(k), b, out)
            }
        }
    }
    out
}

;; Rectangle.intersects of two bodies
func overlap (a, b) {
    (a.x < (b.x + b.w)) && (b.x < (a.x + a.w)) && (a.y < (b.y + b.h)) && (b.y < (a.y + a.h))
}

;; physics.overlap(a, group) (overlapSpriteVsGroup): the bodies of the group
;; (a tag) in the quadtree of this frame that a overlaps, in the order of the
;; quadtree; a itself need not be in it
func overlap_list (a, group) {
    val out = []
    loop _, b in qt_retrieve(Physics.qt, a, []) {
        if (b.group == group) && (b != a) && overlap(a, b) {
            set out@+ = b
        }
    }
    out
}

;; the first of them, or nil
func overlap_any (a, group) {
    val l = overlap_list(a, group)
    if #l > 0 => l@0 => nil
}

;; ArcadePhysics.separateX and separateY (axis :x or :y), OVERLAP_BIAS 4
func separate_axis (b1, b2, axis) {
    if b1.immovable && b2.immovable {
        return false
    }
    if !overlap(b1, b2) {
        return false
    }
    val X = axis == :x
    val p1  = if X => b1.x => b1.y
    val p2  = if X => b2.x => b2.y
    val d1  = if X => (b1.x - b1.px) => (b1.y - b1.py)
    val d2  = if X => (b2.x - b2.px) => (b2.y - b2.py)
    val s1  = if X => b1.w => b1.h
    val s2  = if X => b2.w => b2.h
    val max = (math.abs(d1) + math.abs(d2)) + 4
    var ov = 0
    ifs {
        (d1 == 0) && (d2 == 0) => {
            set b1.embedded = true
            set b2.embedded = true
        }
        d1 > d2 => {
            set ov = (p1 + s1) - p2
            if ov > max {
                set ov = 0
            } else {
                if X { set b1.touching.right = true ; set b2.touching.left = true }
                else { set b1.touching.down  = true ; set b2.touching.up   = true }
            }
        }
        d1 < d2 => {
            set ov = (p1 - s2) - p2
            if -ov > max {
                set ov = 0
            } else {
                if X { set b1.touching.left = true ; set b2.touching.right = true }
                else { set b1.touching.up   = true ; set b2.touching.down  = true }
            }
        }
    }
    if ov == 0 {
        return false
    }
    val v1 = if X => b1.vx => b1.vy
    val v2 = if X => b2.vx => b2.vy
    val bn1 = if X => b1.bx => b1.by
    val bn2 = if X => b2.bx => b2.by
    ifs {
        !b1.immovable && !b2.immovable => {
            val o = ov * 0.5
            val n1 = math.sqrt(((v2 * v2) * b2.mass) / b1.mass) * (if v2 > 0 => 1 => -1)
            val n2 = math.sqrt(((v1 * v1) * b1.mass) / b2.mass) * (if v1 > 0 => 1 => -1)
            val avg = (n1 + n2) * 0.5
            if X {
                set b1.x = b1.x - o
                set b2.x += o
                set b1.vx = avg + ((n1 - avg) * bn1)
                set b2.vx = avg + ((n2 - avg) * bn2)
            } else {
                set b1.y = b1.y - o
                set b2.y += o
                set b1.vy = avg + ((n1 - avg) * bn1)
                set b2.vy = avg + ((n2 - avg) * bn2)
            }
        }
        !b1.immovable => {
            if X {
                set b1.x = b1.x - ov
                set b1.vx = v2 - (v1 * bn1)
            } else {
                set b1.y = b1.y - ov
                set b1.vy = v2 - (v1 * bn1)
            }
        }
        !b2.immovable => {
            if X {
                set b2.x += ov
                set b2.vx = v1 - (v2 * bn2)
            } else {
                set b2.y += ov
                set b2.vy = v1 - (v2 * bn2)
            }
        }
    }
    true
}

;; physics.collide of two sprites (their bodies): separateX, or else
;; separateY; true if they were separated
func collide (b1, b2) {
    separate_axis(b1, b2, :x) || separate_axis(b1, b2, :y)
}

;; Sprite.updateBounds: the corners of the sprite as drawn in the last frame
;; (rotated, from the 32-bit transform, on the screen): topLeft, topRight,
;; bottomLeft, bottomRight, as x y pairs
func sprite_corners (s) {
    val dx, dy, r, sx, sy, fw, fh, ax, ay = (s.dx, s.dy, s.drot, s.dsx, s.dsy, s.img.fw, s.img.fh, s.ax, s.ay)
    val out = [0, 0, 0, 0, 0, 0, 0, 0]
    ```
    double o[8];
    phs_corners(a_dbl($dx), a_dbl($dy), a_dbl($r), a_dbl($sx), a_dbl($sy),
                a_dbl($fw), a_dbl($fh), a_dbl($ax), a_dbl($ay), o);
    for (int i=0; i<8; i++) {
        AVal k = a_int(i);
        AVal v = a_num(o[i]);
        a_setindex($out, k, v);
        a_dec(k);
        a_dec(v);
    }
    ```
    out
}

;; the bounds of the sprite (left, top, right, bottom), from its corners
func sprite_bounds (s) {
    val c = sprite_corners(s)
    (math.min(c@0, c@2, c@4, c@6), math.min(c@1, c@3, c@5, c@7),
     math.max(c@0, c@2, c@4, c@6), math.max(c@1, c@3, c@5, c@7))
}

;; Sprite.inWorld: the bounds of the sprite as drawn, against the bounds of
;; the world (Rectangle.intersects, strict)
func in_world (s) {
    val l, t, r, b = sprite_bounds(s)
    (l < (Physics.x + Physics.w)) && (Physics.x < r) && (t < (Physics.y + Physics.h)) && (Physics.y < b)
}

;; collideSpriteVsGroup: the body against the bodies of a group (a tag) in
;; the quadtree, in its order; true if any was separated
func collide_group (a, group) {
    var any = false
    loop _, b in qt_retrieve(Physics.qt, a, []) {
        if (b.group == group) && (b != a) {
            if collide(a, b) {
                set any = true
            }
        }
    }
    any
}

;; Group: game.add.group() and createMultiple(n, key): n sprites with bodies,
;; dead, in slots, recycled with group_first_dead (getFirstExists(false)).
;; A sprite keeps what it had in its last life (its angle, its frame, the
;; size of its body, inWorld), as in Phaser.
func Group (img, n, tag) {
    val g = :Group [ slots = [] ]
    loop _ in n {
        val s = Sprite(img, 0, 0)
        set s.alive, s.exists, s.visible = (false, false, false)
        val b = Body(s, tag)
        set g.slots@+ = [ s=s, b=b ]
    }
    g
}

;; the bodies of the group leave the physics (at the end of a state)
func group_remove (g) {
    loop _, x in g.slots {
        body_remove(x.b)
    }
}

;; getFirstExists(false): the first slot whose sprite does not exist, or nil
func group_first_dead (g) {
    loop _, x in g.slots {
        if !x.s.exists {
            return x
        }
    }
    nil
}

;; the slots whose sprites exist
func group_living (g) {
    val out = []
    loop _, x in g.slots {
        if x.s.exists {
            set out@+ = x
        }
    }
    out
}

func group_draw (g) {
    loop _, x in g.slots {
        if x.s.visible {
            sprite_draw(x.s)
        }
    }
}

;; getFirstDead(): the first slot whose sprite is not alive, or nil
func group_first_not_alive (g) {
    loop _, x in g.slots {
        if !x.s.alive {
            return x
        }
    }
    nil
}

;; the point (x, y) of the screen in the frame of the sprite, unscaled
func sprite_local (s, px, py) {
    val dx, dy, r, sx, sy, fw, fh, ax, ay = (s.dx, s.dy, s.drot, s.dsx, s.dsy, s.img.fw, s.img.fh, s.ax, s.ay)
    val lx = `:number.float ({ double o[2]; phs_local(a_dbl($dx), a_dbl($dy), a_dbl($r), a_dbl($sx), a_dbl($sy), a_dbl($fw), a_dbl($fh), a_dbl($ax), a_dbl($ay), a_dbl($px), a_dbl($py), o); o[0]; })`
    val ly = `:number.float ({ double o[2]; phs_local(a_dbl($dx), a_dbl($dy), a_dbl($r), a_dbl($sx), a_dbl($sy), a_dbl($fw), a_dbl($fh), a_dbl($ax), a_dbl($ay), a_dbl($px), a_dbl($py), o); o[1]; })`
    (lx, ly)
}
