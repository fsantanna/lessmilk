;; Motion: what the tweens of Phaser did, as tasks.
;;
;;      await Motion(obj, [x=100, y=50], 3000)              ;; linear, 3000 ms
;;      await Motion(obj, [alpha=0], 800, Ease.quad_in)
;;      spawn Motion(enemy, [x=tox, y=toy], 3000)           ;; in parallel
;;
;; A task takes the fields of `obj` given in `to` from their current values
;; to the given ones in `ms` milliseconds. As in Phaser, each value is
;; computed from the time elapsed since the start, not integrated, with the
;; clock of Phaser (eng.now), so that the numbers are the same:
;;
;;      v = start + (end - start) * ease(min(1, (now - start_time) / ms))
;;
;; It moves on the time events, which come before :rl.frame in a frame, as
;; Phaser updates its tweens before the update of the state. TweenManager
;; adds a new tween at the end of its pass over the tweens: a tween started
;; in a create (before frame 1) first moves in frame 2; in an update (frame
;; k), in frame k+2; in the pass itself (by an `onComplete`, or here after
;; the `await` of another Motion, in frame k), in frame k+1. That is: from
;; the first time event after the next :rl.frame. The task ends in the frame in which it
;; reaches the end: `await` goes on there, as an `onComplete` did.
;;
;; What Phaser chained by callbacks (`onComplete`, `.to().to()`, `.loop()`,
;; `.delay()`) is a sequence of awaits here:
;;
;;      await 500ms                             ;; .delay(500)
;;      loop {                                  ;; .to(a).to(b).loop()
;;          await Motion(label, [angle=1], 500)
;;          await Motion(label, [angle=-1], 500)
;;      }

;; The easings that the originals use. The same formulas are in reasings.h of
;; raylib, but in 32-bit floats: here they are in doubles, as in JavaScript,
;; so that the positions are the same as the originals'.
val Ease = [
    ;; Phaser.Easing.Linear.None, the default of a tween
    linear = func (k) {
        k
    },
    ;; Phaser.Easing.Quadratic.In
    quad_in = func (k) {
        k * k
    },
    ;; Phaser.Easing.Bounce.Out
    bounce_out = func (k) {
        ifs {
            k < (1 / 2.75) => 7.5625 * k * k
            k < (2 / 2.75) => (7.5625 * k2 * k2) + 0.75 where { k2 = k - (1.5 / 2.75) }
            k < (2.5 / 2.75) => (7.5625 * k2 * k2) + 0.9375 where { k2 = k - (2.25 / 2.75) }
            else => (7.5625 * k2 * k2) + 0.984375 where { k2 = k - (2.625 / 2.75) }
        }
    },
]

task Motion (obj, to, ms, ease) {
    val f = ease || Ease.linear
    val from = []
    loop k, v in to {
        set from@k = prop_get(obj, k)
    }
    val t0 = eng.now()
    await :rl.frame                 ;; added at the end of the next pass
    loop {
        await :clock
        val t = (eng.now() - t0) / ms
        val e = if t > 1 => 1 => t
        val v = f(e)
        loop k, end in to {
            prop_set(obj, k, from@k + ((end - from@k) * v))
        }
        until e == 1
    }
}
