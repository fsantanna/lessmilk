;; Motion: what the tweens of Phaser did, as tasks.
;;
;;      await Motion(obj, [x=100, y=50], 3000)              ;; linear, 3000 ms
;;      await Motion(obj, [alpha=0], 800, Ease.quad_in)
;;      spawn Motion(enemy, [x=tox, y=toy], 3000)           ;; in parallel
;;
;; A task takes the fields of `obj` given in `to` from their current values
;; to the given ones in `ms` milliseconds. As in Phaser, each value is
;; computed from the time elapsed since the start, not integrated, with the
;; clock of Phaser (eng.now), so that the numbers are the same:
;;
;;      v = start + (end - start) * ease(min(1, (now - start_time) / ms))
;;
;; The tweens are updated as Phaser 1.1.3 updates them (TweenManager): in a
;; list, in order, once per frame, before the sprites (`tweens_pass`, which
;; lib/game.atm calls first in each frame). A new tween goes to a list that
;; is added at the end of the pass: a tween started in a create (before frame
;; 1) first moves in frame 2; in an update (frame k), in frame k+2; in the
;; pass itself (by an `onComplete`, or here after the `await` of another
;; Motion, in frame k), in frame k+1. Two tweens on the same field: the later
;; in the list wins, and a tween that follows another goes to the end.
;;
;; The task Motion ends when its tween ends, inside the pass, as onComplete
;; was called there. If the task is aborted, its tween is deleted (Phaser
;; would go on moving the object). The task ends in the frame in which it
;; reaches the end: `await` goes on there, as an `onComplete` did.
;;
;; What Phaser chained by callbacks (`onComplete`, `.to().to()`, `.loop()`,
;; `.delay()`) is a sequence of awaits here:
;;
;;      await 500ms                             ;; .delay(500)
;;      loop {                                  ;; .to(a).to(b).loop()
;;          await Motion(label, [angle=1], 500)
;;          await Motion(label, [angle=-1], 500)
;;      }

;; the list of tweens, and the tweens added in this pass
val Tweens = [ list = [], add = [] ]

;; The easings that the originals use. The same formulas are in reasings.h of
;; raylib, but in 32-bit floats: here they are in doubles, as in JavaScript,
;; so that the positions are the same as the originals'.
val Ease = [
    ;; Phaser.Easing.Linear.None, the default of a tween
    linear = func (k) {
        k
    },
    ;; Phaser.Easing.Quadratic.In
    quad_in = func (k) {
        k * k
    },
    ;; Phaser.Easing.Bounce.Out
    bounce_out = func (k) {
        ifs {
            k < (1 / 2.75) => 7.5625 * k * k
            k < (2 / 2.75) => (7.5625 * k2 * k2) + 0.75 where { k2 = k - (1.5 / 2.75) }
            k < (2.5 / 2.75) => (7.5625 * k2 * k2) + 0.9375 where { k2 = k - (2.25 / 2.75) }
            else => (7.5625 * k2 * k2) + 0.984375 where { k2 = k - (2.625 / 2.75) }
        }
    },
]

;; `ctl`, optional, is a table whose field `stop` pauses the tween for good,
;; as tween.pause() did: set ctl.stop = true.
;;
;; `delay`, optional, in ms, is tween.delay(): the tween starts at
;; now + delay, in its own timeline, as Phaser computes it (not the same as
;; an `await` before the Motion, which would start it in a later frame).
;;
;; A value given as a string, as "-20" or "+30", is relative to the value at
;; the start, as in Phaser. `ms` is `ms || 1000`, as in Phaser.
task Motion (obj, to, ms, ease, ctl, delay) {
    val r = :Tween [
        obj = obj, f = ease || Ease.linear, dur = ms || 1000, ctl = ctl,
        from = [], end = [],
        t0 = eng.now() + (delay || 0),
        dead = false,
    ]
    loop k, v in to {
        set r.from@k = prop_get(obj, k)
        set r.end@k = if type(v) == "string" => r.from@k + tonumber(v) => v
    }
    defer {
        set r.dead = true                   ;; pendingDelete
    }
    set Tweens.add@+ = r                    ;; TweenManager.add
    await :tween.done until it.r == r
}

;; Tween.update: false when the tween is over (or deleted)
func tween_update (r, now) {
    ifs {
        r.dead => false
        (r.ctl && r.ctl.stop) || (now < r.t0) => true      ;; paused, or in its delay
        else => {
            val t = (now - r.t0) / r.dur
            val e = if t > 1 => 1 => t
            val v = r.f(e)
            loop k, x in r.end {
                prop_set(r.obj, k, r.from@k + ((x - r.from@k) * v))
            }
            if e == 1 {
                set r.dead = true
                emit @:global :tween.done [r=r]     ;; onComplete
                false
            } else {
                true
            }
        }
    }
}

;; TweenManager.update: the tweens in order, then the new ones at the end
func tweens_pass () {
    val now = eng.now()
    var i = 0
    var n = #Tweens.list
    loop {
        while i < n
        if tween_update(Tweens.list@i, now) {
            set i += 1
        } else {
            vector.remove(Tweens.list, i)
            set n -= 1
        }
    }
    loop _, r in Tweens.add {
        set Tweens.list@+ = r
    }
    set Tweens.add = []
}
