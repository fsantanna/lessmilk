;; The engine of the port, over env/raylib.atm: what Phaser gave the games,
;; over the textures, sounds, and drawing of raylib.atm: images and sheets
;; loaded once per path, and drawn with rotation, scale, anchor and alpha;
;; text as Pixi lays it out, in a TTF font at a size; sounds; the clock of
;; Phaser; and the random generator of the harness of the originals.
;;
;;      include "../lib/engine.atm"
;;
;; Positions are in pixels, as in the originals. Angles are in degrees.
;; The games run from the root of the repository: paths are relative to it.

include "../env/raylib.atm"

```:prelude
#include <stdint.h>

///////////////////////////////////////////////////////////////////////////////
// RANDOM: mulberry32, the generator of tools/original/harness.js
///////////////////////////////////////////////////////////////////////////////

static uint32_t eng_seed_v = 1;

static double eng_random (void) {
    eng_seed_v += 0x6D2B79F5u;
    uint32_t t = eng_seed_v;
    t = (t ^ (t >> 15)) * (t | 1u);
    t ^= t + (t ^ (t >> 7)) * (t | 61u);
    return (double)(t ^ (t >> 14)) / 4294967296.0;
}

///////////////////////////////////////////////////////////////////////////////
// PHASER'S GENERATOR: game.rnd, Phaser.RandomDataGenerator of 1.1.3, in the
// arithmetic of JavaScript (ToInt32, ToUint32, Number.prototype.toString)
///////////////////////////////////////////////////////////////////////////////

static uint32_t js_touint32 (double x) {
    if (!isfinite(x)) return 0;
    double m = fmod(trunc(x), 4294967296.0);
    if (m < 0) m += 4294967296.0;
    return (uint32_t)m;
}

static int32_t js_toint32 (double x) {
    return (int32_t)js_touint32(x);
}

// Number.prototype.toString(): the shortest digits that read back as x
static void js_tostring (double x, char* out) {
    if (x == 0) { strcpy(out, "0"); return; }
    if (isnan(x)) { strcpy(out, "NaN"); return; }
    char* o = out;
    if (x < 0) { *o++ = '-'; x = -x; }
    if (isinf(x)) { strcpy(o, "Infinity"); return; }
    char buf[64];
    int p;
    for (p=1; p<=17; p++) {
        snprintf(buf, sizeof(buf), "%.*e", p-1, x);
        if (strtod(buf, NULL) == x) break;
    }
    // buf: d.ddde[+-]XX
    char digits[32]; int k = 0;
    char* e = strchr(buf, 'e');
    for (char* c=buf; c<e; c++) if (*c != '.') digits[k++] = *c;
    while (k > 1 && digits[k-1] == '0') k--;
    digits[k] = '\0';
    int n = atoi(e+1) + 1;
    if (k <= n && n <= 21) {
        o += sprintf(o, "%s", digits);
        for (int i=0; i<n-k; i++) *o++ = '0';
        *o = '\0';
    } else if (0 < n && n <= 21) {
        memcpy(o, digits, n); o += n; *o++ = '.';
        strcpy(o, digits+n);
    } else if (-6 < n && n <= 0) {
        *o++ = '0'; *o++ = '.';
        for (int i=0; i<-n; i++) *o++ = '0';
        strcpy(o, digits);
    } else {
        *o++ = digits[0];
        if (k > 1) { *o++ = '.'; memcpy(o, digits+1, k-1); o += k-1; }
        sprintf(o, "e%c%d", (n-1 >= 0) ? '+' : '-', abs(n-1));
    }
}

static double rdg_c = 1, rdg_s0 = 0, rdg_s1 = 0, rdg_s2 = 0;

static double rdg_hash_s (const char* data) {
    double n = 0xefc8249d, h;
    for (const char* c=data; *c; c++) {
        n += (unsigned char)*c;
        h = 0.02519603282416938 * n;
        n = js_touint32(h);
        h -= n;
        h *= n;
        n = js_touint32(h);
        h -= n;
        n += h * 0x100000000;
    }
    return js_touint32(n) * 2.3283064365386963e-10;
}

static double rdg_hash_n (double x) {
    char buf[64];
    js_tostring(x, buf);
    return rdg_hash_s(buf);
}

static void rdg_sow (const char* seed) {
    rdg_s0 = rdg_hash_s(" ");
    rdg_s1 = rdg_hash_n(rdg_s0);
    rdg_s2 = rdg_hash_n(rdg_s1);
    rdg_c = 1;
    if (seed != NULL && *seed) {
        rdg_s0 -= rdg_hash_s(seed); rdg_s0 += (rdg_s0 < 0);
        rdg_s1 -= rdg_hash_s(seed); rdg_s1 += (rdg_s1 < 0);
        rdg_s2 -= rdg_hash_s(seed); rdg_s2 += (rdg_s2 < 0);
    }
}

static double rdg_rnd (void) {
    double t = 2091639 * rdg_s0 + rdg_c * 2.3283064365386963e-10;
    rdg_c = js_toint32(t);
    rdg_s0 = rdg_s1;
    rdg_s1 = rdg_s2;
    rdg_s2 = t - rdg_c;
    return rdg_s2;
}

static double rdg_frac (void) {
    double a = rdg_rnd();
    double b = rdg_rnd();
    return a + js_toint32(b * 0x200000) * 1.1102230246251565e-16;
}

///////////////////////////////////////////////////////////////////////////////
// FONTS: one per path and size
///////////////////////////////////////////////////////////////////////////////

#define ENG_MAX 256

static struct { char* path; int size; Font font; } eng_fonts[ENG_MAX];
static int eng_nfonts = 0;

static Font* eng_font (const char* path, int size, double scale) {
    for (int i=0; i<eng_nfonts; i++) {
        if (eng_fonts[i].size==size && strcmp(eng_fonts[i].path, path)==0) {
            return &eng_fonts[i].font;
        }
    }
    if (eng_nfonts == ENG_MAX) {
        return NULL;
    }
    // raylib scales a TTF so that ascent+descent is the size; the browser,
    // so that the em is: (ascent+descent)/em
    Font f = LoadFontEx(path, (int)round(size * scale), NULL, 0);
    SetTextureFilter(f.texture, TEXTURE_FILTER_BILINEAR);
    eng_fonts[eng_nfonts].path = strdup(path);
    eng_fonts[eng_nfonts].size = size;
    eng_fonts[eng_nfonts].font = f;
    return &eng_fonts[eng_nfonts++].font;
}

// The height of a line of text, as Pixi measures it in the browser (a div
// with an "M"): the ascent, descent, and gap of the font (hhea, in units of
// the em), each rounded, as Chromium does. Measured in the container for
// Liberation Sans (Arial) at 18 sizes from 10 to 80 px, and for Liberation
// Mono (Courier) at 13: the same.
static double eng_line_height (int size, double asc, double desc, double gap, double upem) {
    return round(size * asc/upem) + round(size * desc/upem) + round(size * gap/upem);
}

// The text, line by line, each line aligned in the box of the widest one
// (align: 0 left, 0.5 center, 1 right), and the box with its anchor (ax,ay)
// at (x,y). Returns the width of the box, and draws only if "draw".
static double eng_text (const char* path, double asc, double desc, double gap,
                        double upem, int size, const char* s,
                        double x, double y, double ax, double ay,
                        double align, Color c, double alpha, int draw) {
    Font* f = eng_font(path, size, (asc + desc) / upem);
    if (f == NULL) {
        return 0;
    }
    char buf[1024];
    strncpy(buf, s, sizeof(buf)-1);
    buf[sizeof(buf)-1] = '\0';
    char* lines[64];
    int n = 0;
    for (char* p=buf; n<64; ) {
        lines[n++] = p;
        char* q = strchr(p, '\n');
        if (q == NULL) break;
        *q = '\0';
        p = q + 1;
    }
    double w = 0;
    for (int i=0; i<n; i++) {
        double lw = MeasureTextEx(*f, lines[i], (float)f->baseSize, 0).x;
        if (lw > w) w = lw;
    }
    double lh = eng_line_height(size, asc, desc, gap, upem);
    w = (int)w;                 // the width of the canvas of a text in Pixi
    double h = lh * n;
    if (draw) {
        c.a = (unsigned char)(c.a * (alpha <= 0 ? 0 : alpha >= 1 ? 1 : alpha));
        double x0 = x - ax * w;
        double y0 = y - ay * h;
        for (int i=0; i<n; i++) {
            double lw = MeasureTextEx(*f, lines[i], (float)f->baseSize, 0).x;
            // the browser draws a line higher than raylib does, by about 0.12
            // of the size: measured 4 px at 30 px and 2 px at 20 px (Run!)
            Vector2 p = { (float)(x0 + align*(w - lw)), (float)(y0 + i*lh - round(size*0.12)) };
            DrawTextEx(*f, lines[i], p, (float)f->baseSize, 0, c);
        }
    }
    return w;
}

```

;; The fonts of the originals: they ask for Arial and Courier, which the
;; browser draws with Liberation Sans and Liberation Mono, fonts with the
;; same metrics (lib/fonts/, SIL OFL 1.1). Each with its hhea metrics: ascent,
;; descent, line gap, and units per em. Paths are relative to the root of the
;; repository, where the games run.
val FONT_SANS = [ path="lib/fonts/LiberationSans-Regular.ttf", asc=1854, desc=434, gap=67, upem=2048 ]
val FONT_MONO = [ path="lib/fonts/LiberationMono-Regular.ttf", asc=1705, desc=615, gap=0,  upem=2048 ]

;; the images and sounds, by path
val ENG_IMAGES = []
val ENG_SOUNDS = []
val ENG_AUDIO  = [ tried = false ]

val eng = [

    ;; eng.seed(s): the seed of the generator, as SEED of a run;
    ;; RL_SEED by default, or 1
    seed = func (s) {
        `eng_seed_v = (uint32_t)(int64_t)a_dbl($s);`
    },

    ;; eng.random(): a number in [0,1), as Math.random in the originals
    random = func () {
        `:number.float eng_random()`
    },

    ;; eng.rnd_*: game.rnd of Phaser 1.1.3 (Phaser.RandomDataGenerator),
    ;; which Phaser seeds when it boots (lib/game.atm)
    rnd_sow = func (seed) {
        `rdg_sow(rl_s($seed));`
    },
    rnd_frac = func () {
        `:number.float rdg_frac()`
    },
    rnd_real_in_range = func (min, max) {
        (`:number.float rdg_frac()` * (max - min)) + min
    },
    rnd_integer_in_range = func (min, max) {
        math.floor((`:number.float rdg_frac()` * (max - min)) + min)
    },

    ;; eng.tostring(x): a number as JavaScript writes it
    tostring = func (x) {
        `:string ({ static char b[64]; js_tostring(a_dbl($x), b); b; })`
    },

    ;; eng.rand(n): an integer in [0,n), as `Math.floor(Math.random() * n)`
    rand = func (n) {
        math.floor(`:number.float eng_random()` * n)
    },

    ;; eng.now(): the clock of Phaser, in milliseconds (game.time.now). In
    ;; test mode, the clock of the harness of the originals, computed the same
    ;; way: frame f is at 1000 + (f-1) * 1000/60. Otherwise, from GetTime.
    now = func () {
        val f = rl.frame()
        if f >= 1 => 1000 + ((f - 1) * (1000 / 60)) => 1000 + (rl.time() * 1000)
    },

    ;; eng.fixed(x, n): x with n decimals, as Number.toFixed in the traces
    fixed = func (x, n) {
        string.format("%." ++ tostring(n) ++ "f", x)
    },

    ;; eng.image(path, [fw, fh]): an image, or a sheet of frames of fw x fh;
    ;; loaded once per path (rl.texture)
    image = func (path, fw, fh) {
        val t = ENG_IMAGES@(path) || do {
            val t = rl.texture(path)
            if rl.texture_id(t) == 0 {
                throw :error, "engine : cannot load image : " ++ path
            }
            set ENG_IMAGES@(path) = t
            t
        }
        val w, h = (rl.texture_width(t), rl.texture_height(t))
        :Image [ tex=t, w=w, h=h, fw=fw || w, fh=fh || h ]
    },

    ;; eng.draw(img, frame, x, y, [ax, ay, angle, sx, sy, alpha]):
    ;; draws a frame of the sheet (left to right, then top to bottom) with
    ;; its anchor (ax,ay) at (x,y), rotated by `angle` degrees around the
    ;; anchor, scaled by (sx,sy) (negative flips), with alpha from 0 to 1
    draw = func (img, frame, x, y, ax, ay, angle, sx, sy, alpha) {
        val fw, fh = (img.fw, img.fh)
        val cols = math.max(1, img.w // fw)
        val sx_, sy_ = (sx || 1, sy || 1)
        val w, h = (fw * math.abs(sx_), fh * math.abs(sy_))
        val sw = if sx_ < 0 => -fw => fw
        val sh = if sy_ < 0 => -fh => fh
        val al = if alpha == nil => 1 => alpha
        val a = math.floor((math.max(0, math.min(1, al)) * 255) + 0.5)
        rl.draw_texture_pro(img.tex, (frame % cols) * fw, (frame // cols) * fh, sw, sh,
            x, y, w, h, (ax || 0) * w, (ay || 0) * h, angle || 0, 0xFFFFFF00 | a)
    },

    ;; eng.text(s, x, y, size, [color, ax, ay, align, alpha, font]): draws
    ;; the text with its anchor at (x,y); lines are aligned by `align` (0 to
    ;; 1); FONT_SANS by default
    text = func (s, x, y, size, color, ax, ay, align, alpha, font) {
        val c = color || 0xFFFFFFFF
        val ax_, ay_, al_ = (ax || 0, ay || 0, align || 0)
        val a = if alpha == nil => 1 => alpha
        val f = font || FONT_SANS
        val p, as, ds, gp, em = (f.path, f.asc, f.desc, f.gap, f.upem)
        `eng_text(rl_s($p), a_dbl($as), a_dbl($ds), a_dbl($gp), a_dbl($em), (int)a_dbl($size), rl_s($s), a_dbl($x), a_dbl($y), a_dbl($ax_), a_dbl($ay_), a_dbl($al_), rl_color($c), a_dbl($a), 1);`
    },

    ;; eng.measure(s, size, [font]): the width of the text
    measure = func (s, size, font) {
        val f = font || FONT_SANS
        val p, as, ds, gp, em = (f.path, f.asc, f.desc, f.gap, f.upem)
        `:number eng_text(rl_s($p), a_dbl($as), a_dbl($ds), a_dbl($gp), a_dbl($em), (int)a_dbl($size), rl_s($s), 0, 0, 0, 0, 0, WHITE, 1, 0)`
    },

    ;; eng.sound(path): a sound, loaded once per path (rl.sound); with no
    ;; audio device, as in the tests, sounds do nothing
    sound = func (path) {
        if !ENG_AUDIO.tried {
            set ENG_AUDIO.tried = true
            if !os.getenv("RL_FRAMES") {
                rl.audio_init()
            }
        }
        ENG_SOUNDS@(path) || do {
            val snd = rl.sound(path)
            set ENG_SOUNDS@(path) = snd
            snd
        }
    },
    ;; eng.play(snd, [volume])
    play = func (snd, volume) {
        rl.sound_volume(snd, if volume == nil => 1 => volume)
        rl.play_sound(snd)
    },
]

do {
    val s = os.getenv("RL_SEED")
    eng.seed(if s => tonumber(s) => 1)
}
