```:prelude
// Phaser.Math.wrapAngle: wrap(angle, -180, 180), with the % of JavaScript
static double spr_wrap_angle (double a) {
    double r = fmod(a - (-180), 360);
    if (r < 0) r += 360;
    return r + (-180);
}
```

;; Sprite: an image or a sheet, with a position, an anchor, an angle, a
;; scale, an alpha, and named animations, as a sprite of Phaser 1.1.3.
;;
;;      val p = Sprite(img, 175, 175)
;;      sprite_add(p, :left, [6, 7], 10, true)  ;; animations.add
;;      sprite_play(p, :left)                   ;; animations.play
;;      sprite_stop(p)                          ;; animations.stop
;;      sprite_update(p)                        ;; once per frame
;;      sprite_draw(p)                          ;; in :rl.draw
;;
;; The frames of an animation follow the clock of Phaser (eng.now), as
;; Phaser.Animation does: a frame every 1000/fps ms, with the late frames
;; skipped, and `sprite_play` of the animation that already plays does not
;; restart it. `sprite_update` is called where Phaser updates the sprite:
;; after the tweens, before the update of the state.

func Sprite (img, x, y) {
    :Sprite [
        img = img,
        x = x, y = y,
        ax = 0, ay = 0,             ;; anchor
        rot = 0,                    ;; the rotation, in radians (angle_get/set)
        sx = 1, sy = 1,             ;; scale
        alpha = 1,
        visible = true,
        frame = 0,                  ;; the frame on display
        anims = [],                 ;; name -> [frames, delay, loop]
        cur = nil,                  ;; the current animation
        playing = false,
        index = 0,                  ;; in the frames of the current animation
        next = 0,                   ;; time of the next frame
    ]
}

;; sprite.angle of Phaser: the sprite keeps its rotation in radians, and the
;; angle in degrees is wrapped to [-180, 180) when set and when read:
;;      get: wrapAngle(radToDeg(rotation))
;;      set: rotation = degToRad(wrapAngle(value))
func angle_get (s) {
    val r = s.rot
    `:number.float spr_wrap_angle(a_dbl($r) * (180 / M_PI))`
}
func angle_set (s, v) {
    set s.rot = `:number.float spr_wrap_angle(a_dbl($v)) * (M_PI / 180)`
}

;; a field of a sprite, for Motion: `angle` through angle_get and angle_set
func prop_get (o, k) {
    if (k == "angle") && (o ?? :Sprite) => angle_get(o) => o@(k)
}
func prop_set (o, k, v) {
    if (k == "angle") && (o ?? :Sprite) {
        angle_set(o, v)
    } else {
        set o@(k) = v
    }
}

;; the size of a frame, scaled
func sprite_w (s) { s.img.fw * math.abs(s.sx) }
func sprite_h (s) { s.img.fh * math.abs(s.sy) }

;; animations.add(name, frames, fps, loop): as in Phaser, the animation
;; becomes the current one, stopped, showing its first frame; with no frames,
;; all the frames of the sheet
func sprite_add (s, name, frames, fps, loop_) {
    val fs = frames || do {
        val n = (s.img.w // s.img.fw) * (s.img.h // s.img.fh)
        val all = []
        loop i in n {
            set all@+ = i
        }
        all
    }
    val a = [ frames=fs, delay=1000/(fps || 60), loop=loop_ || false ]
    set s.anims@(name) = a
    set s.cur = a
    set s.playing = false
    set s.index = 0
    set s.frame = fs@0
    a
}

;; animations.play(name, [fps, loop])
func sprite_play (s, name, fps, loop_) {
    val a = s.anims@(name)
    if a && ((a != s.cur) || !s.playing) {
        if fps {
            set a.delay = 1000 / fps
        }
        if loop_ != nil {
            set a.loop = loop_
        }
        set s.cur = a
        set s.playing = true
        set s.index = 0
        set s.next = eng.now() + a.delay
        set s.frame = a.frames@0
    }
}

;; animations.stop(): the frame on display stays
func sprite_stop (s) {
    set s.playing = false
}

;; Phaser.Animation.update
func sprite_update (s) {
    val a = s.cur
    val now = eng.now()
    if a && s.playing && (now >= s.next) {
        var skip = 1
        var diff = now - s.next
        if diff > a.delay {
            set skip = math.floor(diff / a.delay)
            set diff -= skip * a.delay
        }
        set s.next = now + (a.delay - diff)
        set s.index += skip
        if s.index >= #a.frames {
            if a.loop {
                set s.index = s.index % #a.frames
                set s.frame = a.frames@(s.index)
            } else {
                set s.playing = false       ;; onComplete
            }
        } else {
            set s.frame = a.frames@(s.index)
        }
    }
}

func sprite_draw (s) {
    if s.visible {
        eng.draw(s.img, s.frame, s.x, s.y, s.ax, s.ay, (s.rot * 180) / math.pi, s.sx, s.sy, s.alpha)
    }
}

;; Text: a text of Phaser (Pixi), with its anchor and alpha. Its box is as
;; wide as its widest line and as tall as its lines (eng.text).
;;
;;      val t = Text(175, 300, "use the arrow keys", 20)
;;      set t.ay = 1
;;      text_draw(t)
func Text (x, y, s, size, align) {
    :Text [
        x = x, y = y, s = s, size = size,
        ax = 0, ay = 0, alpha = 1, visible = true,
        align = align || 0,         ;; 0 left, 0.5 center, 1 right
        color = 0xFFFFFFFF,
    ]
}

func text_draw (t) {
    if t.visible {
        eng.text(t.s, t.x, t.y, t.size, t.color, t.ax, t.ay, t.align, t.alpha)
    }
}
