;; Checks lib/engine.atm: the random generator (the same numbers as the
;; harness of the originals), a sheet drawn with rotation, scale and alpha,
;; and text anchored and aligned.

include "../../lib/engine.atm"

rl.window [title="engine", width=350, height=350]

eng.seed(7)
print(eng.random(), eng.random(), eng.rand(350), eng.rand(4))

val player = eng.image("assets/1/images/player.png", 20, 24)
val enemy  = eng.image("assets/1/images/enemy1.png", 32, 36)
print(player.w, player.h, player.fw, player.fh)

;; Number.prototype.toString and game.rnd of Phaser 1.1.3 (the same numbers
;; as RandomDataGenerator.js run in node)
print(eng.tostring(1e-7), eng.tostring(1/3), eng.tostring(1e21), eng.tostring(11.7047531530261))
eng.rnd_sow("1000")
print(eng.rnd_integer_in_range(-200,200), eng.rnd_integer_in_range(-200,200), eng.rnd_frac())
print(eng.measure("score: 0", 20))

spawn {
    loop on :rl.draw {
        rl.clear(0x34495EFF)
        eng.draw(player, 0, 175, 175, 0.5, 0.5)
        eng.draw(player, 5, 40, 40)
        eng.draw(enemy, 1, 100, 250, 0.5, 0.5, 45)
        eng.draw(enemy, 0, 250, 250, 0.5, 0.5, 0, 2, 2, 0.5)
        eng.text("score: 0", 15, 10, 20)
        eng.text("game over\n\nscore: 3", 175, 175, 30, nil, 0.5, 0.5, 0.5)
    }
}
await :rl.quit
