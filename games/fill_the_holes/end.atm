;; End: the clicks of the whole game; boxes, holes, and walls fall.

task End () {
    input_reset()
    val l1 = Text(W/2, (H/2) - 20, "you won! :-D", 30)
    val l2 = Text(W/2, (H/2) + 20, "you clicked " ++ tostring(user_clicks) ++ " times during the game", 20)
    loop _, t in [l1, l2] {
        set t.ax, t.ay = (0.5, 0.5)
    }
    set l1.sx, l1.sy = (1, 1)
    spawn Pulse(l1, 1.3, 1000)
    val emitter = Emitter([IMG_BOX, IMG_HOLE, IMG_WALL], 100)
    set emitter.x, emitter.y = (W/2, -200)
    spawn Emitter_run(emitter)
    emitter_start(emitter, false, 5000, 200)
    loop on :rl.draw {
        rl.clear(BG)
        text_draw(l1)
        text_draw(l2)
        emitter_draw(emitter)
    }
}
