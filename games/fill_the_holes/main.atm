;; Fill the Holes (lessmilk.com, game #5, 2014), by Thomas Palef.
;; Ported to Atmos from the original (Phaser 1.1.3) and from the port of
;; Jessica Oliveira (jessicacoliveira/atmos-lessmilk, fill_the_holes).
;;
;; Click a side of a box to push it; it slides until a wall, a hole, or out
;; of the board. Fill all the holes of each level.

include "../../lib/game.atm"

val W, H = (500, 400)
val BG = 0x1ABC9CFF
val A = "assets/5/"
val TILE = 50
val OX, OY = (25, 50)

var user_clicks = 0         ;; the global of the original

;; [trace]
var screen = "Menu"
val Fill = [ play = nil ]
;; [/trace]

rl.window [title="Fill the Holes", width=W, height=H]

include "levels.atm"
include "menu.atm"
include "play.atm"
include "end.atm"

spawn Game(W, H)

;; [trace]
spawn {
    if os.getenv("RL_FRAMES") {
        loop on :rl.frame {
            print(trace())
        }
    }
}
;; [/trace]

await Menu()
;; [trace]
set screen = "Play"
;; [/trace]
await Play()
;; [trace]
set screen = "End"
;; [/trace]
await End()
