;; Save the City (lessmilk.com, game #8, 2014), by Thomas Palef.
;; Ported to Atmos from the original (Phaser 1.1.3) and from the port of
;; Jessica Oliveira (jessicacoliveira/atmos-lessmilk, save_the_city).
;;
;; Type the sentences: each letter flies to the bomb and pushes it up. From
;; the second sentence on, the bomb falls; when it reaches the city, the
;; city is gone, and a button plays again.

include "../../lib/game.atm"

val W, H = (500, 500)
val BG = 0xE67E22FF
val A = "assets/8/"

;; what the trace reads
val Save = [ level=0, i=0, score=0, dead=false, letters=0 ]

rl.window [title="Save the City", width=W, height=H]

include "play.atm"

spawn Game(W, H)

;; [trace]
spawn {
    if os.getenv("RL_FRAMES") {
        loop on :rl.frame {
            print(trace())
        }
    }
}
;; [/trace]

loop {
    await Play()
}
