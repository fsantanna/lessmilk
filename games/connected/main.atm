;; Connected (lessmilk.com, game #7, 2014), by Thomas Palef.
;; Ported to Atmos from the original (Phaser 1.1.3) and from the port of
;; Jessica Oliveira (jessicacoliveira/atmos-lessmilk, connected).
;;
;; Connect dots of the same color with the mouse; twenty moves; the more
;; dots in a move, the more each is worth.

include "../../lib/game.atm"

val W, H = (400, 500)
val BG = 0xECF0F1FF
val INK = 0x2C3E50FF
val A = "assets/7/"

var score, best_score = (0, 0)      ;; the globals of the original
var sound = true

;; [trace]
var screen = "Menu"
val Con = [ play = nil ]
;; [/trace]

rl.window [title="Connected", width=W, height=H]

include "menu.atm"
include "play.atm"
include "end.atm"

spawn Game(W, H)

;; [trace]
spawn {
    if os.getenv("RL_FRAMES") {
        loop on :rl.frame {
            print(trace())
        }
    }
}
;; [/trace]

await Menu()
loop {
    ;; [trace]
    set screen = "Play"
    ;; [/trace]
    await Play()
    ;; [trace]
    set screen = "End"
    ;; [/trace]
    await End()
}
