;; Box Jump (lessmilk.com, game #3, 2014), by Thomas Palef.
;; Ported to Atmos from the original (Phaser 1.1.3) and from the port of
;; Jessica Oliveira (jessicacoliveira/atmos-lessmilk, box_jump).
;;
;; The player runs on a line and jumps over cubes, level after level; a cube
;; that touches it sends it back to the start of the level. Play ends after
;; the last level, and End shows the deaths.

include "../../lib/game.atm"

val W, H = (600, 200)
val BG = 0x9B59B6FF
val A = "assets/3/"

var death = 0               ;; the global `death` of the original

;; the level, and what the trace reads
val Box = [ level = 0 ]

;; [trace]
var screen = "Play"
;; [/trace]

rl.window [title="Box Jump", width=W, height=H]

include "map.atm"
include "play.atm"
include "end.atm"

spawn Game(W, H)

;; [trace]
spawn {
    if os.getenv("RL_FRAMES") {
        loop on :rl.frame {
            print(trace())
        }
    }
}
;; [/trace]

await Play()
;; [trace]
set screen = "End"
;; [/trace]
await End()
