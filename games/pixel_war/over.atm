;; Over: the score, and UP to play again, but only after 800 ms.

val SND_DEAD = eng.sound(A ++ "sounds/dead.wav")

task Over (shown) {
    val keys = Cursor()
    val label = Text(W/2, H/2, "game over\n\nscore: " ++ tostring(shown) ++
                     "\n\npress the UP arrow\nkey to restart", 30, 0.5)
    set label.ax, label.ay = (0.5, 0.5)
    eng.play(SND_DEAD, 0.2)
    spawn {
        loop on :rl.draw {
            rl.clear(BG)
            text_draw(label)
        }
    }
    await Wait(800)
    if !cursor_down(keys, 'UP') {
        await :update until cursor_down(keys, 'UP')
    }
}
