;; I Hate Rabbits (lessmilk.com, game #9, 2014), by Thomas Palef.
;; Ported to Atmos from the original (Phaser 1.1.3) and from the port of
;; Jessica Oliveira (jessicacoliveira/atmos-lessmilk, i_hate_rabbits).
;;
;; The bad one walks around the circle; the rabbits of each level come to the
;; circle, and SPACE makes the next one jump over the bad one. Nine levels,
;; one per turn; then the rabbits saved.

include "../../lib/game.atm"

val W, H = (450, 450)
val BG = 0x2ECC71FF
val A = "assets/9/"

var score, level, best_score = (0, 0, 0)    ;; the globals of the original

;; [trace]
var screen = "Menu"
val Rab = [ play = nil ]
;; [/trace]

rl.window [title="I Hate Rabbits", width=W, height=H]

include "level.atm"
include "menu.atm"
include "play.atm"
include "end.atm"

spawn Game(W, H)

;; [trace]
spawn {
    if os.getenv("RL_FRAMES") {
        loop on :rl.frame {
            print(trace())
        }
    }
}
;; [/trace]

await Menu()
loop {
    ;; [trace]
    set screen = "Play"
    ;; [/trace]
    await Play()
    ;; [trace]
    set screen = "End"
    ;; [/trace]
    await End()
}
