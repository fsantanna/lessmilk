;; Menu: the bad one walks, a label pulses; SPACE starts.

val IMG_BAD    = eng.image(A ++ "images/bad.png", 36, 40)
val IMG_CIRCLE = eng.image(A ++ "images/circle.png")

;; a pulse of a scale, for ever: .to(big).to(1).loop()
task Pulse (o, big, small, ms) {
    loop {
        await Motion(o, [sx=big, sy=big], ms)
        await Motion(o, [sx=small, sy=small], ms)
    }
}

task Menu () {
    val bad = Sprite(IMG_BAD, W/2, (H/2) - 120)
    set bad.ax, bad.ay = (0.5, 1)
    sprite_add(bad, :walk, [0, 1], 5, true)
    sprite_play(bad, :walk)
    val circle = Sprite(IMG_CIRCLE, W/2, H/2)
    set circle.ax, circle.ay = (0.5, 0.5)
    val start = Text((W/2) + 0.5, (H/2) + 0.5, "press space to\nstart the game", 20, 0.5)
    val help  = Text((W/2) + 0.5, H - 30, "try to save the rabbits by pressing space", 20, 0.5)
    val title = Text((W/2) + 0.5, 30, "I Hate Rabbits!", 30, 0.5)
    loop _, t in [start, help, title] {
        set t.ax, t.ay = (0.5, 0.5)
    }
    set start.sx, start.sy = (1, 1)
    spawn Pulse(start, 1.1, 1, 300)
    spawn {
        loop on :pre {
            sprite_update(bad)
        }
    }
    spawn {
        loop on :rl.draw {
            rl.clear(BG)
            sprite_draw(bad)
            sprite_draw(circle)
            text_draw(start)
            text_draw(help)
            text_draw(title)
        }
    }
    await :rl.key.dn until it.name == 'SPACE'          ;; space_key.onDown
}
