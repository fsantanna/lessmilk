;; Play: the man, the penguins (a group of 40), the coin, the level.

val IMG_BRICK  = eng.image(A ++ "images/brick.png")
val IMG_PLAYER = eng.image(A ++ "images/player.png", 27, 33)
val IMG_ENEMY  = eng.image(A ++ "images/enemy.png", 18, 27)
val IMG_COIN   = eng.image(A ++ "images/coin.png")
val SND_KILL  = eng.sound(A ++ "sounds/kill.wav")
val SND_JUMP  = eng.sound(A ++ "sounds/jump.wav")
val SND_COIN  = eng.sound(A ++ "sounds/coin.wav")
val SND_DEAD  = eng.sound(A ++ "sounds/dead.wav")
val SND_MUSIC = eng.sound(A ++ "sounds/music.wav")

;; the coins, by score
val COINS0 = [[150, H/2], [W-150, H/2], [50, H-100], [W-50, H-100]]
val COINS1 = COINS0 ++ [[60, 100], [W-60, 100]]
val COINS2 = COINS1 ++ [[130, 50], [W-130, 50], [200, H-60], [W-200, H-60]]

;; rand(num) of the original
func rand (n) {
    eng.rand(n)
}

;; the level: the bricks, scaled, of two groups (x, y, ax, ay, sx, sy)
val PLATFORMS = [
    [0, H, 0, 1, 11, 1], [0, H-20, 0, 1, 4, 1],
    [(W/2)+30, H, 0, 1, 11, 1], [(W/2)+170, H-20, 0, 1, 4, 1],
    [0, 0, 0, 0, 9, 1], [(W/2)+60, 0, 0, 0, 9, 1],
    [W/2, ((H*1)/4)+10, 0.5, 0.5, 14, 1], [W/2, ((H*3)/4)-10, 0.5, 0.5, 14, 1],
    [0, H/2, 0, 0.5, 5, 1], [(W/2)+150, H/2, 0, 0.5, 5, 1],
]
val WALLS = [ [0, 0, 0, 0, 1, 17.5], [W, 0, 1, 0, 1, 17.5] ]

;; a group made with group.create, of sprites that exist
func Bricks (list, tag) {
    val g = :Group [ slots = [] ]
    loop _, d in list {
        val s = Sprite(IMG_BRICK, d@0, d@1)
        val b = Body(s, tag)
        set s.ax, s.ay, s.sx, s.sy = (d@2, d@3, d@4, d@5)
        set b.immovable = true
        set s.alive, s.exists, s.visible = (true, true, true)
        set g.slots@+ = [ s=s, b=b ]
    }
    g
}

;; shakeScreen: the camera, in y and in x, three tweens each, chained
task Shake (k, i, t) {
    await Motion(Camera, [@(k)=i], t)
    await Motion(Camera, [@(k)=-i], t)
    await Motion(Camera, [@(k)=0], t)
}

;; playerDie: the man falls; then (onComplete) playerInit
task Fall (p) {
    await Motion(p, [y=H+10], 500)
    set p.x, p.y = (W/2, H/2)
    set p.alive = true
}

;; enemyDie: the penguin flattens, then dies
task Flatten (e) {
    await Motion(e, [sy=0], 150)
    sprite_kill(e)
}

task Play () {
    set Physics.x, Physics.y, Physics.w, Physics.h = (-50, -50, 800, 800)     ;; world.setBounds
    val keys = Cursor()
    val player = Sprite(IMG_PLAYER, W/2, H/2)
    val pbody = Body(player, :player)
    set pbody.gy = 12
    set player.ax, player.ay = (0.5, 0.5)
    set player.alive = true
    sprite_add(player, :walk, [1, 2], 6, true)
    var jump_count = 1

    val enemies = Group(IMG_ENEMY, 40, :enemy)
    loop _, x in enemies.slots {
        set x.s.oob_kill = true
    }

    val coin = Sprite(IMG_COIN, 150, H/2)
    val cbody = Body(coin, :coin)
    set cbody.gy, cbody.by = (10, 0.3)
    set coin.ax, coin.ay = (0.5, 0.5)

    val label_score = Text(30, 30, "score: 0", 16)
    val label_best  = Text(30, 50, "best: 0", 16)
    set label_best.sx, label_best.sy = (1, 1)
    val label_tuto  = Text((W/2) + 0.5, ((H/2) - 20) + 0.5,
        "1- arrow keys to move\n2- take coins for score\n3- jump on penguins to kill", 18)
    set label_tuto.ax, label_tuto.ay = (0.5, 0.5)
    var score, best = (0, 0)
    var coin_x = 0
    var half = 1
    var enemy_time = 0
    eng.play(SND_MUSIC, 0.3)
    val platforms = Bricks(PLATFORMS, :platform)
    val walls     = Bricks(WALLS, :wall)
    pin tweens = tasks()
    defer {
        group_remove(enemies)
        group_remove(platforms)
        group_remove(walls)
        body_remove(pbody)
        body_remove(cbody)
    }

    ;; [trace]
    set Pen.play = [ player=player, pbody=pbody, enemies=enemies, coin=coin,
                     score=\{ score }, best=\{ best }, jump=\{ jump_count } ]
    ;; [/trace]

    spawn {
        loop on :rl.draw {
            rl.clear(BG)
            sprite_draw(player)
            group_draw(enemies)
            sprite_draw(coin)
            text_draw(label_score)
            text_draw(label_best)
            text_draw(label_tuto)
            group_draw(platforms)
            group_draw(walls)
        }
    }
    spawn {
        loop on :pre {
            sprite_update(player)
            loop _, x in enemies.slots {
                if x.s.exists {
                    sprite_update(x.s)
                }
            }
        }
    }

    val func shake (i, t) {
        spawn @tweens Shake("y", i, t)
        spawn @tweens Shake("x", i, t)
    }

    val func enemy_die (e, all) {
        spawn @tweens Flatten(e)
        set e.alive = false
        if !all {
            eng.play(SND_KILL, 0.15)
            shake(2, 80)
            emit @:global :kill
        }
    }

    val func player_die () {
        if player.alive {
            eng.play(SND_DEAD, 0.1)
            set player.alive = false
            spawn @tweens Fall(player)
            spawn @tweens Motion(player, [angle=360], 500)
            ;; updateBestScore
            if best < score {
                set best = score
                set label_best.s = "best: " ++ tostring(best)
                set label_best.sx, label_best.sy = (2, 2)
                spawn @tweens Motion(label_best, [sx=1, sy=1], 300)
            }
            set score = 0
            set label_score.s = "score: 0"
            loop _, x in enemies.slots {
                if x.s.alive {
                    enemy_die(x.s, true)
                }
            }
            shake(10, 100)
        }
    }

    val func new_enemy () {
        val x = group_first_dead(enemies)
        if x {
            val e = x.s
            sprite_reset(e, x.b, W/2, 0)
            set e.sx, e.sy = (1, 1)
            set e.ax, e.ay = (0.5, 1)
            set x.b.gy = 5
            set x.b.vx = 0
            sprite_add(e, :walk, [0, 1], 3, true)
            if half == 1 {
                set e.sx, e.sy = (-1, 1)
                set half = 0
            } else {
                set half = 1
            }
        }
    }

    ;; the tutorial fades once the man took a coin and killed a penguin (the
    ;; flags oneCoin and oneKill, and the label's alive, of the original)
    spawn {
        await <:coin && :kill>
        spawn @tweens Motion(label_tuto, [alpha=0], 1000)
    }

    ;; the update, in the order of the original
    loop on :update {
        collide_group(pbody, :platform)
        collide_group(pbody, :wall)
        loop _, x in enemies.slots {
            if x.s.exists {
                collide_group(x.b, :platform)
            }
        }
        collide_group(cbody, :platform)

        ;; overlap(enemies, walls): the penguin turns at a wall
        loop _, x in enemies.slots {
            if x.s.exists {
                loop _, wb in overlap_list(x.b, :wall) {
                    val e = x.s
                    set x.b.vx *= -1
                    if e.x < (H/2) {
                        set e.sx, e.sy = (-1, 1)
                        set e.x = (50 + ((e.sx * IMG_ENEMY.fw) / 2)) + 1
                    } else {
                        set e.sx, e.sy = (1, 1)
                        set e.x = ((W - 20) - ((e.sx * IMG_ENEMY.fw) / 2)) - 1
                    }
                }
            }
        }

        ;; overlap(player, enemies): a jump on a penguin, or a death
        loop _, eb in overlap_list(pbody, :enemy) {
            val e = eb.spr
            val pc = sprite_corners(player)
            val ec = sprite_corners(e)
            ;; player.bottomRight.y < enemy.topRight.y + 10
            if !pbody.touching.down && (pc@7 < (ec@3 + 10)) && e.alive && player.alive {
                set pbody.vy = -150
                enemy_die(e, false)
                set jump_count = 5
            } else {
                player_die()
            }
        }

        ;; overlap(player, coin): the coin goes elsewhere
        if overlap(pbody, cbody) {
            set score += 1
            set label_score.s = "score: " ++ tostring(score)
            val tab = ifs {
                score <= 5  => COINS0
                score <= 10 => COINS1
                else => COINS2
            }
            eng.play(SND_COIN, 0.15)
            var ra = rand(#tab)
            if ra == coin_x {
                set ra = (ra + 1) % #tab
            }
            set coin_x = ra
            sprite_reset(coin, cbody, tab@(ra)@0, tab@(ra)@1)
            emit @:global :coin
        }

        set pbody.vx = 0
        ;; updateEnemy: a penguin that lands walks; one that falls out is
        ;; replaced
        loop _, x in enemies.slots {
            val e = x.s
            if e.alive {
                if (x.b.vx == 0) && x.b.touching.down {
                    set x.b.vx = -70
                    sprite_play(e, :walk)
                    if e.sx == -1 {
                        set x.b.vx *= -1
                    }
                }
                if e.alive && (e.y >= (H + ((e.sy * IMG_ENEMY.fh) / 2))) {
                    set e.alive = false
                    new_enemy()
                }
            }
        }

        ifs {
            cursor_down(keys, 'LEFT') && player.alive => {
                set pbody.vx = if pbody.touching.down => -200 => -150
                sprite_play(player, :walk)
                set player.sx, player.sy = (-1, 1)
            }
            cursor_down(keys, 'RIGHT') && player.alive => {
                set pbody.vx = if pbody.touching.down => 200 => 150
                sprite_play(player, :walk)
                set player.sx, player.sy = (1, 1)
            }
            else => {
                sprite_stop(player)
                set player.frame = 0
            }
        }

        ;; the jump: higher while UP is held, up to 20 updates (the count of
        ;; the original)
        ifs {
            cursor_down(keys, 'UP') && pbody.touching.down => {
                eng.play(SND_JUMP, 0.08)
                set jump_count = 1
                set pbody.vy = -200
            }
            cursor_down(keys, 'UP') && (jump_count < 20) && (jump_count != 0) => {
                set jump_count += 1
                set pbody.vy = -200
            }
            else => set jump_count = 0
        }

        ;; a penguin now and then (enemyTime): a comparison with the clock in
        ;; the update, since its draw of random comes after the one of the
        ;; coin, in the same update
        if eng.now() > enemy_time {
            set enemy_time = ((eng.now() + 2000) + rand(500)) - math.min(score * 20, 1000)
            new_enemy()
        }

        if (player.y > (H + (player.sy * IMG_PLAYER.fh))) || (player.y < (0 - ((player.sy * IMG_PLAYER.fh) / 2))) {
            player_die()
        }

    }
}

;; [trace]
;; the line of the trace: as tools/original/trace/4.js
func trace () {
    val f = rl.frame()
    if screen != "Play" {
        return tostring(f) ++ " " ++ screen
    }
    val p = Pen.play
    var n, a, sx, sy = (0, 0, 0, 0)
    loop _, x in p.enemies.slots {
        if x.s.exists {
            set n += 1
            set sx += x.s.x
            set sy += x.s.y
            if x.s.alive {
                set a += 1
            }
        }
    }
    tostring(f) ++ " Play " ++ tostring(p.score()) ++ " " ++ tostring(p.best()) ++ " " ++
        eng.fixed(p.player.x, 2) ++ " " ++ eng.fixed(p.player.y, 2) ++ " " ++
        eng.fixed(p.pbody.vx, 2) ++ " " ++ eng.fixed(p.pbody.vy, 2) ++ " " ++
        (if p.player.alive => "1" => "0") ++ " " ++ tostring(p.jump()) ++ " " ++
        tostring(n) ++ " " ++ tostring(a) ++ " " ++ eng.fixed(sx, 2) ++ " " ++ eng.fixed(sy, 2) ++ " " ++
        eng.fixed(p.coin.x, 2) ++ " " ++ eng.fixed(p.coin.y, 2) ++ " " ++
        tostring(Camera.x) ++ " " ++ tostring(Camera.y)
}
;; [/trace]
